<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXScrollPane?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import io.github.palexdev.materialfx.controls.MFXSpinner?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<MFXScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ueadmission.publishResult.PublishResultController">
    <VBox spacing="0" stylesheets="@publish-result.css">
        <!-- 🔷 Navbar -->
        <HBox id="navbar" alignment="CENTER_LEFT" spacing="30" style="-fx-background-color: #FA4506;">
            <padding>
                <Insets topRightBottomLeft="15" />
            </padding>
            <ImageView fitHeight="40" fitWidth="40">
                <image>
                    <Image url="@../uiu_logo_update.png" />
                </image>
            </ImageView>
            <Label id="title" style="-fx-text-fill: white; -fx-font-weight: bold;" text="United International University" />
            <Region fx:id="spacer" HBox.hgrow="ALWAYS" />
            <MFXButton id="nav-button" fx:id="homeButton" styleClass="mfx-button" text="Home" />
            <MFXButton id="nav-button" fx:id="aboutButton" styleClass="mfx-button" text="About" />
            <MFXButton id="nav-button" fx:id="admissionButton" styleClass="mfx-button" text="Admission" />
            <MFXButton id="nav-button" fx:id="examPortalButton" styleClass="mfx-button" text="Exam Portal" />
            <MFXButton id="nav-button" fx:id="contactButton" styleClass="mfx-button" text="Contact" />

            <!-- Profile button container - always visible on profile page -->
            <HBox id="profileButtonContainer" alignment="CENTER">
                <children>
                    <com.ueadmission.components.ProfileButton fx:id="profileButton" styleClass="profile-button-container" />
                </children>
            </HBox>
        </HBox>

        <!-- Publish Result Header Section -->
        <VBox id="publish-result-header" alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" right="20" bottom="30" left="20" />
            </padding>

            <Label styleClass="page-title" text="Publish Exam Results" />
            <Label styleClass="page-subtitle" text="Manage and publish examination results" />
        </VBox>

        <!-- Publish Result Content Section -->
        <VBox id="publish-result-content" spacing="20">
            <padding>
                <Insets top="20" right="30" bottom="40" left="30" />
            </padding>

            <!-- Loading Spinner (Hidden by default) -->
            <StackPane fx:id="loaderContainer" visible="false" managed="false" styleClass="loader-container">
                <VBox alignment="CENTER" spacing="15">
                    <ImageView fitHeight="80" fitWidth="80">
                        <image>
                            <Image url="@../loading.gif" />
                        </image>
                    </ImageView>
                    <Label text="Loading data..." styleClass="loader-text" />
                </VBox>
            </StackPane>

            <!-- Global Settings Panel -->
            <VBox id="global-settings-panel" spacing="20" styleClass="content-panel" maxWidth="1000" alignment="CENTER">
                <padding>
                    <Insets top="25" right="30" bottom="25" left="30" />
                </padding>

                <!-- Section Title -->
                <Label text="Global Result Settings" styleClass="section-title"/>

                <!-- Global Settings Form -->
                <GridPane fx:id="globalSettingsGrid" hgap="20" vgap="15" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="180" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <!-- Minimum Pass Mark -->
                    <Label text="Minimum Pass Mark (%):" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <MFXTextField fx:id="passMarkField" text="40.00" promptText="Enter pass mark percentage" styleClass="form-field" prefWidth="150" />
                        <MFXButton fx:id="applyPassMarkButton" text="Apply to All Schools" styleClass="mfx-button-small" />
                    </HBox>

                </GridPane>
            </VBox>

            <!-- School Results Panels -->
            <HBox spacing="20" alignment="CENTER">
                <!-- Engineering & Technology -->
                <VBox id="engineering-panel" spacing="15" styleClass="school-panel">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>

                    <Label text="School of Engineering &amp; Technology" styleClass="school-title" />

                    <!-- Analytics -->
                    <VBox styleClass="analytics-container" spacing="10">
                        <HBox styleClass="analytics-row">
                            <Label text="Total Students:" styleClass="analytics-label" />
                            <Label fx:id="engTotalStudents" text="0" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Completed Exams:" styleClass="analytics-label" />
                            <Label fx:id="engCompletedExams" text="0" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Average Score:" styleClass="analytics-label" />
                            <Label fx:id="engAverageScore" text="0.00" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Pass Rate:" styleClass="analytics-label" />
                            <Label fx:id="engPassRate" text="0%" styleClass="analytics-value" />
                        </HBox>
                    </VBox>

                    <!-- School-specific pass mark -->
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Pass Mark:" styleClass="pass-mark-label" />
                        <MFXTextField fx:id="engPassMarkField" text="40.00" styleClass="pass-mark-field" prefWidth="80" />
                        <Label fx:id="engPercentLabel" text="Percent" />
                    </HBox>

                    <!-- Publication Status -->
                    <HBox styleClass="status-container" alignment="CENTER">
                        <Label fx:id="engPublishStatus" text="Not Published" styleClass="status-not-published" />
                    </HBox>

                    <!-- Publish Button -->
                    <MFXButton fx:id="engPublishButton" text="Publish Results" styleClass="publish-button" />
                </VBox>

                <!-- Business & Economics -->
                <VBox id="business-panel" spacing="15" styleClass="school-panel">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>

                    <Label text="School of Business &amp; Economics" styleClass="school-title" />

                    <!-- Analytics -->
                    <VBox styleClass="analytics-container" spacing="10">
                        <HBox styleClass="analytics-row">
                            <Label text="Total Students:" styleClass="analytics-label" />
                            <Label fx:id="busTotalStudents" text="0" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Completed Exams:" styleClass="analytics-label" />
                            <Label fx:id="busCompletedExams" text="0" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Average Score:" styleClass="analytics-label" />
                            <Label fx:id="busAverageScore" text="0.00" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Pass Rate:" styleClass="analytics-label" />
                            <Label fx:id="busPassRate" text="0%" styleClass="analytics-value" />
                        </HBox>
                    </VBox>

                    <!-- School-specific pass mark -->
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Pass Mark:" styleClass="pass-mark-label" />
                        <MFXTextField fx:id="busPassMarkField" text="40.00" styleClass="pass-mark-field" prefWidth="80" />
                        <Label fx:id="busPercentLabel" text="Percent" />
                    </HBox>

                    <!-- Publication Status -->
                    <HBox styleClass="status-container" alignment="CENTER">
                        <Label fx:id="busPublishStatus" text="Not Published" styleClass="status-not-published" />
                    </HBox>

                    <!-- Publish Button -->
                    <MFXButton fx:id="busPublishButton" text="Publish Results" styleClass="publish-button" />
                </VBox>
            </HBox>

            <HBox spacing="20" alignment="CENTER">
                <!-- Humanities & Social Sciences -->
                <VBox id="humanities-panel" spacing="15" styleClass="school-panel">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>

                    <Label text="School of Humanities &amp; Social Sciences" styleClass="school-title" />

                    <!-- Analytics -->
                    <VBox styleClass="analytics-container" spacing="10">
                        <HBox styleClass="analytics-row">
                            <Label text="Total Students:" styleClass="analytics-label" />
                            <Label fx:id="humTotalStudents" text="0" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Completed Exams:" styleClass="analytics-label" />
                            <Label fx:id="humCompletedExams" text="0" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Average Score:" styleClass="analytics-label" />
                            <Label fx:id="humAverageScore" text="0.00" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Pass Rate:" styleClass="analytics-label" />
                            <Label fx:id="humPassRate" text="0%" styleClass="analytics-value" />
                        </HBox>
                    </VBox>

                    <!-- School-specific pass mark -->
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Pass Mark:" styleClass="pass-mark-label" />
                        <MFXTextField fx:id="humPassMarkField" text="40.00" styleClass="pass-mark-field" prefWidth="80" />
                        <Label fx:id="humPercentLabel" text="Percent" />
                    </HBox>

                    <!-- Publication Status -->
                    <HBox styleClass="status-container" alignment="CENTER">
                        <Label fx:id="humPublishStatus" text="Not Published" styleClass="status-not-published" />
                    </HBox>

                    <!-- Publish Button -->
                    <MFXButton fx:id="humPublishButton" text="Publish Results" styleClass="publish-button" />
                </VBox>

                <!-- Life Sciences -->
                <VBox id="life-sciences-panel" spacing="15" styleClass="school-panel">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>

                    <Label text="School of Life Sciences" styleClass="school-title" />

                    <!-- Analytics -->
                    <VBox styleClass="analytics-container" spacing="10">
                        <HBox styleClass="analytics-row">
                            <Label text="Total Students:" styleClass="analytics-label" />
                            <Label fx:id="lifeTotalStudents" text="0" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Completed Exams:" styleClass="analytics-label" />
                            <Label fx:id="lifeCompletedExams" text="0" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Average Score:" styleClass="analytics-label" />
                            <Label fx:id="lifeAverageScore" text="0.00" styleClass="analytics-value" />
                        </HBox>
                        <HBox styleClass="analytics-row">
                            <Label text="Pass Rate:" styleClass="analytics-label" />
                            <Label fx:id="lifePassRate" text="0%" styleClass="analytics-value" />
                        </HBox>
                    </VBox>

                    <!-- School-specific pass mark -->
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Pass Mark:" styleClass="pass-mark-label" />
                        <MFXTextField fx:id="lifePassMarkField" text="40.00" styleClass="pass-mark-field" prefWidth="80" />
                        <Label fx:id="lifePercentLabel" text="Percent" />
                    </HBox>

                    <!-- Publication Status -->
                    <HBox styleClass="status-container" alignment="CENTER">
                        <Label fx:id="lifePublishStatus" text="Not Published" styleClass="status-not-published" />
                    </HBox>

                    <!-- Publish Button -->
                    <MFXButton fx:id="lifePublishButton" text="Publish Results" styleClass="publish-button" />
                </VBox>
            </HBox>

            <!-- Global Action Buttons -->
            <HBox alignment="CENTER" spacing="20" styleClass="global-button-container">
                <MFXButton fx:id="publishAllButton" text="Publish All Results" styleClass="publish-all-button" />
                <MFXButton fx:id="refreshButton" text="Refresh Data" styleClass="refresh-button" />
            </HBox>
        </VBox>

        <!-- Footer -->
        <VBox id="footer" alignment="CENTER" spacing="30" style="-fx-background-color: #222222;">
            <padding>
                <Insets top="50" right="20" bottom="30" left="20" />
            </padding>
            <HBox alignment="CENTER" spacing="60">
                <VBox spacing="15" alignment="CENTER_LEFT" maxWidth="300">
                    <ImageView fitHeight="60" fitWidth="60">
                        <image>
                            <Image url="@../uiu_logo_update.png" />
                        </image>
                    </ImageView>
                    <Label styleClass="footer-text" text="UIU is committed to providing quality education and preparing students for the global challenges through innovative teaching methods and research." wrapText="true" />
                </VBox>
                <VBox spacing="15" alignment="CENTER_LEFT">
                    <Label styleClass="footer-title" text="Quick Links" />
                    <Label styleClass="footer-link" text="Home" />
                    <Label styleClass="footer-link" text="About UIU" />
                    <Label styleClass="footer-link" text="Apply Now" />
                    <Label styleClass="footer-link" text="Academic Programs" />
                </VBox>
                <VBox spacing="15" alignment="CENTER_LEFT">
                    <Label styleClass="footer-title" text="Resources" />
                    <Label styleClass="footer-link" text="Student Portal" />
                    <Label styleClass="footer-link" text="Exam Portal" />
                    <Label styleClass="footer-link" text="FAQ" />
                    <Label styleClass="footer-link" text="Help Center" />
                </VBox>
                <VBox spacing="15" alignment="CENTER_LEFT">
                    <Label styleClass="footer-title" text="Social Media" />
                    <Label styleClass="footer-link" text="Facebook" />
                    <Label styleClass="footer-link" text="Twitter" />
                    <Label styleClass="footer-link" text="LinkedIn" />
                    <Label styleClass="footer-link" text="Instagram" />
                </VBox>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Label styleClass="copyright" text="© 2025 United International University. All rights reserved." />
            </HBox>
            <Label styleClass="developer" text="Developed by PhantomDevs" style="-fx-text-fill: #FA4506;" />
        </VBox>
    </VBox>
</MFXScrollPane>
