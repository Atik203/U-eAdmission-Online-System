<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXScrollPane?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import io.github.palexdev.materialfx.controls.MFXSpinner?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<MFXScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ueadmission.publishResult.PublishResultController">
    <VBox spacing="0" stylesheets="@publish-result.css">
        <!-- 🔷 Navbar -->
        <HBox id="navbar" alignment="CENTER_LEFT" spacing="30" style="-fx-background-color: #FA4506;">
            <padding>
                <Insets topRightBottomLeft="15" />
            </padding>
            <ImageView fitHeight="40" fitWidth="40">
                <image>
                    <Image url="@../uiu_logo_update.png" />
                </image>
            </ImageView>
            <Label id="title" style="-fx-text-fill: white; -fx-font-weight: bold;" text="United International University" />
            <Region fx:id="spacer" HBox.hgrow="ALWAYS" />
            <MFXButton id="nav-button" fx:id="homeButton" styleClass="mfx-button" text="Home" />
            <MFXButton id="nav-button" fx:id="aboutButton" styleClass="mfx-button" text="About" />
            <MFXButton id="nav-button" fx:id="admissionButton" styleClass="mfx-button" text="Admission" />
            <MFXButton id="nav-button" fx:id="examPortalButton" styleClass="mfx-button" text="Exam Portal" />
            <MFXButton id="nav-button" fx:id="contactButton" styleClass="mfx-button" text="Contact" />
            
            <!-- Profile button container - always visible on profile page -->
            <HBox id="profileButtonContainer" alignment="CENTER">
                <children>
                    <com.ueadmission.components.ProfileButton fx:id="profileButton" styleClass="profile-button-container" />
                </children>
            </HBox>
        </HBox>

        <!-- Publish Result Header Section -->
        <VBox id="publish-result-header" alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" right="20" bottom="30" left="20" />
            </padding>
            
            <Label styleClass="page-title" text="Publish Exam Results" />
            <Label styleClass="page-subtitle" text="Manage and publish examination results" />
        </VBox>
        
        <!-- Publish Result Content Section -->
        <VBox id="publish-result-content" spacing="20">
            <padding>
                <Insets top="20" right="30" bottom="40" left="30" />
            </padding>
            
            <!-- Publish Result Panel -->
            <VBox id="publish-result-panel" spacing="20" styleClass="content-panel" maxWidth="800" alignment="CENTER">
                <padding>
                    <Insets top="25" right="30" bottom="25" left="30" />
                </padding>
                
                <!-- Section Title -->
                <Label text="Publish Examination Results" styleClass="section-title"/>
                
                <!-- Loading Spinner (Hidden by default) -->
                <StackPane fx:id="loaderContainer" visible="false" managed="false" styleClass="loader-container">
                    <VBox alignment="CENTER" spacing="15">
                        <ImageView fitHeight="80" fitWidth="80">
                            <image>
                                <Image url="@../loading.gif" />
                            </image>
                        </ImageView>
                        <Label text="Loading data..." styleClass="loader-text" />
                    </VBox>
                </StackPane>
                
                <!-- Result Publication Form -->
                <GridPane fx:id="resultFormGrid" hgap="20" vgap="15" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="180" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    
                    <!-- Exam Name -->
                    <Label text="Exam Name:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <MFXTextField fx:id="examNameField" promptText="Enter exam name" styleClass="form-field" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    
                    <!-- Exam Date -->
                    <Label text="Exam Date:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <MFXTextField fx:id="examDateField" promptText="YYYY-MM-DD" styleClass="form-field" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    
                    <!-- Department -->
                    <Label text="Department:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <MFXTextField fx:id="departmentField" promptText="Enter department" styleClass="form-field" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    
                    <!-- Semester -->
                    <Label text="Semester:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <MFXTextField fx:id="semesterField" promptText="Enter semester" styleClass="form-field" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    
                    <!-- Result File -->
                    <Label text="Result File:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                    <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="1">
                        <MFXTextField fx:id="resultFileField" promptText="No file selected" styleClass="form-field" HBox.hgrow="ALWAYS" editable="false" />
                        <MFXButton fx:id="browseButton" text="Browse" styleClass="mfx-button-small" />
                    </HBox>
                    
                    <!-- Publication Date -->
                    <Label text="Publication Date:" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                    <MFXTextField fx:id="publicationDateField" promptText="YYYY-MM-DD" styleClass="form-field" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                    
                    <!-- Notes -->
                    <Label text="Notes:" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                    <MFXTextField fx:id="notesField" promptText="Additional notes (optional)" styleClass="form-field" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                </GridPane>
                
                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="15" styleClass="button-container">
                    <MFXButton fx:id="publishButton" text="Publish Result" styleClass="mfx-button-primary" />
                    <MFXButton fx:id="clearButton" text="Clear Form" styleClass="mfx-button-outline" />
                </HBox>
            </VBox>
        </VBox>
        
        <!-- Footer -->
        <VBox id="footer" alignment="CENTER" spacing="30" style="-fx-background-color: #222222;">
            <padding>
                <Insets top="50" right="20" bottom="30" left="20" />
            </padding>
            <HBox alignment="CENTER" spacing="60">
                <VBox spacing="15" alignment="CENTER_LEFT" maxWidth="300">
                    <ImageView fitHeight="60" fitWidth="60">
                        <image>
                            <Image url="@../uiu_logo_update.png" />
                        </image>
                    </ImageView>
                    <Label styleClass="footer-text" text="UIU is committed to providing quality education and preparing students for the global challenges through innovative teaching methods and research." wrapText="true" />
                </VBox>
                <VBox spacing="15" alignment="CENTER_LEFT">
                    <Label styleClass="footer-title" text="Quick Links" />
                    <Label styleClass="footer-link" text="Home" />
                    <Label styleClass="footer-link" text="About UIU" />
                    <Label styleClass="footer-link" text="Apply Now" />
                    <Label styleClass="footer-link" text="Academic Programs" />
                </VBox>
                <VBox spacing="15" alignment="CENTER_LEFT">
                    <Label styleClass="footer-title" text="Resources" />
                    <Label styleClass="footer-link" text="Student Portal" />
                    <Label styleClass="footer-link" text="Exam Portal" />
                    <Label styleClass="footer-link" text="FAQ" />
                    <Label styleClass="footer-link" text="Help Center" />
                </VBox>
                <VBox spacing="15" alignment="CENTER_LEFT">
                    <Label styleClass="footer-title" text="Social Media" />
                    <Label styleClass="footer-link" text="Facebook" />
                    <Label styleClass="footer-link" text="Twitter" />
                    <Label styleClass="footer-link" text="LinkedIn" />
                    <Label styleClass="footer-link" text="Instagram" />
                </VBox>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Label styleClass="copyright" text="© 2025 United International University. All rights reserved." />
            </HBox>
            <Label styleClass="developer" text="Developed by PhantomDevs" style="-fx-text-fill: #FA4506;" />
        </VBox>
    </VBox>
</MFXScrollPane>